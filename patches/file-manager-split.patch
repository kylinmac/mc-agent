diff --git a/views-src/src/lib/markdownScroll.ts b/views-src/src/lib/markdownScroll.ts
new file mode 100644
index 0000000..3bf6195
--- /dev/null
+++ b/views-src/src/lib/markdownScroll.ts
@@ -0,0 +1,91 @@
+import type { EditorView } from "@codemirror/view";
+
+type Point = { editor: number; preview: number };
+type Side = keyof Point;
+
+export function bindMarkdownScroll(view: EditorView, preview: HTMLElement): () => void {
+  const editor = view.scrollDOM;
+  let frame = 0;
+  let leader: Side = "editor";
+  let stopped = false;
+
+  const synchronize = () => {
+    frame = 0;
+    if (stopped || !preview.isConnected) return;
+    const previewTop = preview.getBoundingClientRect().top - preview.scrollTop;
+    const editorTop = view.documentTop - editor.getBoundingClientRect().top + editor.scrollTop;
+    const points: Point[] = [{ editor: 0, preview: 0 }];
+    for (const element of preview.querySelectorAll<HTMLElement>("[data-source-line]")) {
+      const line = Number(element.dataset.sourceLine);
+      const end = Number(element.dataset.sourceEnd);
+      if (line < 1 || line > view.state.doc.lines || !element.getClientRects().length) continue;
+      const rect = element.getBoundingClientRect();
+      points.push({ editor: editorTop + view.lineBlockAt(view.state.doc.line(line).from).top, preview: rect.top - previewTop });
+      if (element.matches(".md-code > code")) {
+        const height = Number.parseFloat(getComputedStyle(element).lineHeight);
+        for (let codeLine = line + 1; codeLine < end && codeLine <= view.state.doc.lines; codeLine++) {
+          points.push({ editor: editorTop + view.lineBlockAt(view.state.doc.line(codeLine).from).top, preview: rect.top - previewTop + (codeLine - line) * height });
+        }
+      }
+      // Nested blocks supply their own boundaries; a parent's bottom would obscure them.
+      if (end > line && !element.querySelector("[data-source-line]")) {
+        const last = view.state.doc.line(Math.min(end - 1, view.state.doc.lines));
+        points.push({ editor: editorTop + view.lineBlockAt(last.from).bottom, preview: rect.bottom - previewTop });
+      }
+    }
+    // shortcut: interpolate inside wrapped paragraphs; use character positions if finer alignment is needed.
+    points.sort((a, b) => a.editor - b.editor || a.preview - b.preview);
+    const anchors: Point[] = [];
+    for (const point of points) {
+      const previous = anchors.at(-1);
+      if (!previous || (point.editor > previous.editor && point.preview > previous.preview)) anchors.push(point);
+    }
+    const from = leader === "editor" ? editor : preview;
+    const to = leader === "editor" ? preview : editor;
+    const target: Side = leader === "editor" ? "preview" : "editor";
+    const position = from.scrollTop;
+    const max = Math.max(0, from.scrollHeight - from.clientHeight);
+    const targetMax = Math.max(0, to.scrollHeight - to.clientHeight);
+    let destination = 0;
+    if (max > 0 && position >= max - 1) destination = targetMax;
+    else if (position > 0 && anchors.length > 1) {
+      let index = 0;
+      while (index + 1 < anchors.length && anchors[index + 1][leader] <= position) index++;
+      const a = anchors[index];
+      const b = anchors[Math.min(index + 1, anchors.length - 1)];
+      const fraction = b[leader] > a[leader] ? (position - a[leader]) / (b[leader] - a[leader]) : 0;
+      destination = a[target] + fraction * (b[target] - a[target]);
+    }
+    destination = Math.min(targetMax, Math.max(0, destination));
+    if (Math.abs(to.scrollTop - destination) > 0.5) {
+      to.scrollTop = destination;
+    }
+  };
+  const schedule = () => {
+    if (!frame && !stopped) frame = requestAnimationFrame(synchronize);
+  };
+  // CodeMirror corrects estimated heights after revealing off-screen lines.
+  // Only a new user gesture changes the leader; those corrections must not pull it back.
+  const section = preview.closest("section")!;
+  const chooseLeader = (event: Event) => {
+    if (event.target instanceof Element) leader = event.target.closest(".cm-editor") ? "editor" : "preview";
+  };
+  const events = ["wheel", "pointerdown", "keydown", "input"] as const;
+  for (const event of events) section.addEventListener(event, chooseLeader, { capture: true, passive: true });
+  editor.addEventListener("scroll", schedule, { passive: true });
+  preview.addEventListener("scroll", schedule, { passive: true });
+  const resize = new ResizeObserver(schedule);
+  resize.observe(editor);
+  resize.observe(view.contentDOM);
+  resize.observe(preview);
+  if (preview.firstElementChild) resize.observe(preview.firstElementChild);
+  schedule();
+  return () => {
+    stopped = true;
+    cancelAnimationFrame(frame);
+    resize.disconnect();
+    for (const event of events) section.removeEventListener(event, chooseLeader, true);
+    editor.removeEventListener("scroll", schedule);
+    preview.removeEventListener("scroll", schedule);
+  };
+}
